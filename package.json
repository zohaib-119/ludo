{
  "name": "dodice-ludo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/engine/tsconfig.test.json --noEmit && tsc -p packages/protocol --noEmit && tsc -p packages/bot/tsconfig.test.json --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "sim": "tsx packages/engine/scripts/simulate.ts",
    "server": "npm run start -w @ludo/server",
    "arena": "tsx packages/bot/scripts/arena.ts",
    "e2e": "playwright test",
    "dev:web": "npm run dev -w @ludo/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^3.23.2",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
